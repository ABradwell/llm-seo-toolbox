{
  "name": "llm-ready",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source audit and authoring studio for LLM-ready websites.",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/ABradwell/llm-seo-toolbox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ABradwell/llm-seo-toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/ABradwell/llm-seo-toolbox/issues"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "pnpm --filter @llm-seo-toolbox/cli build",
    "build:action": "pnpm --filter @llm-seo-toolbox/action build",
    "build:packages": "pnpm build:cli && pnpm build:action",
    "cli": "node packages/cli/dist/index.js",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@llm-seo-toolbox/core": "workspace:*",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --fix"
  }
}
