{
  "openapi": "3.1.0",
  "info": {
    "title": "LLMReady Audit API",
    "version": "1.2.0",
    "summary": "Audit a site for LLM and AI crawler readiness.",
    "description": "Fetches a site's initial HTML plus its discovery files, classifies the site, and returns a weighted four-pillar audit. Site scope (the default) samples up to eight pages and scores the origin; page scope scores the entered page. Access checks cover 16 AI crawlers grouped by search, fetch and training intent, and a small number of agent fetches verify that AI user agents receive the same content. Results are cached for five minutes per server instance. The public instance allows 30 weighted credits per minute per IP: a site audit costs 3 and a page audit costs 1.",
    "license": {
      "name": "GPL-3.0-only",
      "identifier": "GPL-3.0-only"
    },
    "contact": {
      "name": "LLMReady contributors",
      "url": "https://github.com/ABradwell/llm-seo-toolbox"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This deployment"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Audit",
      "description": "Classify a site and audit its AI discovery surface."
    }
  ],
  "paths": {
    "/api/audit": {
      "get": {
        "operationId": "auditSite",
        "summary": "Audit a site or page",
        "description": "Runs the Discovery, Access, Parseability and Schema pillars. Site scope (the default) builds a deterministic sample of up to eight pages from the origin, scores the site and returns the entered page as a focus-page drill-down. Page scope preserves the single-page audit. Supply a bare domain or an absolute URL; a missing scheme defaults to https://.",
        "tags": [
          "Audit"
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "The site to audit. A bare domain or a full URL. Internal, private and reserved hosts are rejected.",
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "example": "example.com"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Pin a compatibility profile instead of using automatic classification. The detected profile is still returned in classification.detected.",
            "schema": {
              "type": "string",
              "enum": [
                "saas",
                "portfolio",
                "docs",
                "ecommerce",
                "local-business",
                "blog-media"
              ]
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "site (default) scores the origin from a deterministic sample of up to eight pages. page preserves the single-page V2 audit and scores the entered page directly.",
            "schema": {
              "type": "string",
              "enum": [
                "site",
                "page"
              ],
              "default": "site"
            },
            "example": "site"
          }
        ],
        "responses": {
          "200": {
            "description": "The completed audit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditResult"
                }
              }
            },
            "headers": {
              "X-Audit-Cache": {
                "description": "Whether the whole request was served from the in-memory cache.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "hit",
                    "miss"
                  ]
                }
              },
              "X-Audit-Scope": {
                "description": "The effective audit scope.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "site",
                    "page"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid URL, unknown site type or scope, or a blocked URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditApiError"
                }
              }
            }
          },
          "415": {
            "description": "The URL did not return an HTML page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditApiError"
                }
              }
            }
          },
          "429": {
            "description": "Weighted rate limit exhausted. Wait for the number of seconds in the Retry-After header. Site audits cost 3 credits and page audits cost 1.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until another audit can be requested.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditApiError"
                }
              }
            }
          },
          "500": {
            "description": "The audit failed unexpectedly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditApiError"
                }
              }
            }
          },
          "502": {
            "description": "The target site could not be fetched or returned an HTTP error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditResult": {
        "type": "object",
        "required": [
          "url",
          "finalUrl",
          "domain",
          "score",
          "grade",
          "gradeLabel",
          "pillars",
          "classification",
          "profile",
          "pages",
          "files",
          "fixes",
          "meta",
          "scope",
          "focusUrl",
          "pageResults",
          "focusPage",
          "coverage",
          "freshness",
          "agentFetch"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "site",
              "page"
            ],
            "description": "site scores the origin from a sample; page scores the entered page directly."
          },
          "url": {
            "type": "string",
            "description": "The URL as requested."
          },
          "finalUrl": {
            "type": "string",
            "description": "The site root after redirects. For both scopes this is the origin-level anchor."
          },
          "domain": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "grade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "F"
            ]
          },
          "gradeLabel": {
            "type": "string",
            "example": "Nearly ready"
          },
          "pillars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditPillar"
            }
          },
          "classification": {
            "$ref": "#/components/schemas/SiteClassification"
          },
          "profile": {
            "$ref": "#/components/schemas/SiteProfile"
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditPage"
            },
            "description": "Inventory for the llms.txt editor, capped at 80 URLs."
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscoveryFile"
            }
          },
          "vision": {
            "type": "object",
            "description": "Raw HTML and cleaned markdown for the focus page, with payload and token estimates.",
            "additionalProperties": true
          },
          "fixes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueuedFix"
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "fetchMs",
              "pageCount",
              "crawledAt",
              "cached",
              "discoveredPageCount",
              "sampledPageCount",
              "siteCached",
              "focusCached",
              "scoringVersion"
            ],
            "properties": {
              "fetchMs": {
                "type": "integer"
              },
              "pageCount": {
                "type": "integer",
                "description": "Kept for compatibility: the number of URLs in pages (the display cap)."
              },
              "crawledAt": {
                "type": "string",
                "format": "date-time"
              },
              "cached": {
                "type": "boolean"
              },
              "discoveredPageCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Every unique page-like URL found before the display cap."
              },
              "sampledPageCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Pages that produced page-level checks."
              },
              "siteCached": {
                "type": "boolean",
                "description": "Whether the origin base (classification, discovery, inventory and sample) came from cache."
              },
              "focusCached": {
                "type": "boolean",
                "description": "Whether the focus page drill-down came from cache."
              },
              "scoringVersion": {
                "type": "string",
                "enum": [
                  "site-2"
                ]
              }
            }
          },
          "focusUrl": {
            "type": "string",
            "format": "uri",
            "description": "The page the user entered after redirects. It is a drill-down and only contributes to a site score when the sample already selected it."
          },
          "pageResults": {
            "type": "array",
            "description": "Pages whose page-level checks feed the site score. In page scope this contains only the focus page.",
            "items": {
              "$ref": "#/components/schemas/PageAuditResult"
            }
          },
          "focusPage": {
            "$ref": "#/components/schemas/PageAuditResult"
          },
          "coverage": {
            "$ref": "#/components/schemas/AuditCoverage"
          },
          "freshness": {
            "description": "Freshest machine-readable date found on the homepage. Null when no date is exposed.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/FreshnessSignal"
              },
              {
                "type": "null"
              }
            ]
          },
          "agentFetch": {
            "type": "array",
            "description": "AI user-agent fetches compared with the default fetch. Empty when agent fetch probing is disabled or fails.",
            "items": {
              "$ref": "#/components/schemas/AgentFetchComparison"
            }
          }
        }
      },
      "AuditPillar": {
        "type": "object",
        "required": [
          "id",
          "name",
          "shortName",
          "description",
          "score",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "discovery",
              "access",
              "parseability",
              "structured"
            ]
          },
          "name": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditCheck"
            }
          }
        }
      },
      "AuditCheck": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "summary",
          "detail",
          "weight",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "info"
            ]
          },
          "summary": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/CheckEvidence"
          },
          "fix": {
            "$ref": "#/components/schemas/CheckFix"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scope": {
            "type": "string",
            "enum": [
              "site",
              "page"
            ],
            "description": "Whether the check runs once for the origin or once per sampled page."
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Mean status score for an aggregated page check. When absent, scorePillar falls back to status points."
          },
          "sample": {
            "$ref": "#/components/schemas/PageSampleSummary"
          }
        }
      },
      "CheckEvidence": {
        "type": "object",
        "required": [
          "file",
          "line",
          "snippet"
        ],
        "properties": {
          "file": {
            "type": "string",
            "example": "/robots.txt"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "snippet": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CheckFix": {
        "type": "object",
        "required": [
          "language",
          "code"
        ],
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "markdown",
              "robots",
              "html",
              "json",
              "http",
              "yaml",
              "text"
            ]
          },
          "code": {
            "type": "string"
          }
        }
      },
      "SiteClassification": {
        "type": "object",
        "required": [
          "type",
          "label",
          "confidence",
          "method",
          "detected",
          "alternatives",
          "signals",
          "compatibility"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/SiteType"
          },
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "method": {
            "type": "string",
            "enum": [
              "heuristic",
              "override"
            ]
          },
          "detected": {
            "type": "object",
            "required": [
              "type",
              "label",
              "confidence"
            ],
            "properties": {
              "type": {
                "$ref": "#/components/schemas/SiteType"
              },
              "label": {
                "type": "string"
              },
              "confidence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "alternatives": {
            "type": "array",
            "description": "Every profile ranked by automatic support, highest first. The detected profile is first and carries the headline confidence.",
            "items": {
              "type": "object",
              "required": ["type", "label", "confidence"],
              "properties": {
                "type": {
                  "$ref": "#/components/schemas/SiteType"
                },
                "label": {
                  "type": "string"
                },
                "confidence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "label",
                "detail",
                "weight",
                "source"
              ],
              "properties": {
                "type": {
                  "$ref": "#/components/schemas/SiteType"
                },
                "label": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "url",
                    "hostname",
                    "structured-data",
                    "metadata",
                    "markup",
                    "manifest",
                    "fallback"
                  ]
                }
              }
            }
          },
          "compatibility": {
            "type": "object",
            "required": [
              "openApiScored",
              "requiredSchema",
              "recommendedSchema",
              "faqExpected",
              "note"
            ],
            "properties": {
              "openApiScored": {
                "type": "boolean"
              },
              "requiredSchema": {
                "type": "array",
                "description": "At least one of these schema types must be present for schema-types to pass.",
                "items": {
                  "type": "string"
                }
              },
              "recommendedSchema": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "faqExpected": {
                "type": "boolean",
                "description": "Whether FAQ content is weighted for this profile."
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      },
      "SiteType": {
        "type": "string",
        "enum": [
          "saas",
          "portfolio",
          "docs",
          "ecommerce",
          "local-business",
          "blog-media"
        ]
      },
      "SiteProfile": {
        "type": "object",
        "required": [
          "url",
          "finalUrl",
          "domain",
          "title",
          "description",
          "siteName",
          "language"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "finalUrl": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "siteName": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "required": [
          "url",
          "label",
          "section",
          "source"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "sitemap",
              "link",
              "home"
            ]
          }
        }
      },
      "DiscoveryFile": {
        "type": "object",
        "required": [
          "id",
          "label",
          "path",
          "url",
          "found",
          "statusCode",
          "bytes",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "found": {
            "type": "boolean"
          },
          "statusCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "bytes": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "QueuedFix": {
        "type": "object",
        "required": [
          "checkId",
          "pillarId",
          "pillarName",
          "label",
          "status",
          "summary",
          "recommendation",
          "weight",
          "scope"
        ],
        "properties": {
          "checkId": {
            "type": "string"
          },
          "pillarId": {
            "type": "string"
          },
          "pillarName": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "warn",
              "fail"
            ]
          },
          "summary": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/CheckEvidence"
          },
          "fix": {
            "$ref": "#/components/schemas/CheckFix"
          },
          "weight": {
            "type": "number"
          },
          "scope": {
            "type": "string",
            "enum": [
              "site",
              "page"
            ]
          },
          "sample": {
            "$ref": "#/components/schemas/PageSampleSummary"
          }
        }
      },
      "AuditApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "missing_url"
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            }
          }
        }
      },
      "PageSampleSummary": {
        "type": "object",
        "required": [
          "total",
          "passed",
          "warned",
          "failed",
          "affected"
        ],
        "description": "Coverage for a page-level check aggregated across the analyzed sample.",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Pages that produced an observation."
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "warned": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "affected": {
            "type": "array",
            "description": "Non-passing page URLs, capped for transport.",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "PageAuditResult": {
        "type": "object",
        "required": [
          "url",
          "finalUrl",
          "label",
          "section",
          "source",
          "outcome",
          "status",
          "score",
          "grade",
          "checks",
          "title",
          "textChars",
          "snr",
          "h1Count",
          "headingCount",
          "jsonLdTypes",
          "structuredFormats",
          "metaRobots",
          "xRobotsTag",
          "freshness",
          "faqPairs",
          "hasFaqSchema",
          "identity",
          "descriptionChars",
          "canonical",
          "fetchMs"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "finalUrl": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "home",
              "sitemap",
              "link",
              "focus"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "analyzed",
              "unreachable",
              "not-html",
              "off-origin"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "info"
            ]
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "grade": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "F",
              null
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditCheck"
            }
          },
          "title": {
            "type": "string"
          },
          "textChars": {
            "type": "integer",
            "minimum": 0
          },
          "snr": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "h1Count": {
            "type": "integer",
            "minimum": 0
          },
          "headingCount": {
            "type": "integer",
            "minimum": 0
          },
          "jsonLdTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "structuredFormats": {
            "type": "array",
            "description": "Structured-data encodings found on the page.",
            "items": {
              "$ref": "#/components/schemas/StructuredDataFormat"
            }
          },
          "metaRobots": {
            "type": "string"
          },
          "xRobotsTag": {
            "type": [
              "string",
              "null"
            ]
          },
          "freshness": {
            "description": "Freshest machine-readable date on the page. Null when no date is exposed.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/FreshnessSignal"
              },
              {
                "type": "null"
              }
            ]
          },
          "faqPairs": {
            "type": "integer",
            "minimum": 0,
            "description": "Visible question-and-answer pairs found in the content."
          },
          "hasFaqSchema": {
            "type": "boolean",
            "description": "Whether the page carries a FAQPage node with a mainEntity list."
          },
          "identity": {
            "type": "array",
            "description": "Person and Organization nodes found in the page's structured data.",
            "items": {
              "$ref": "#/components/schemas/IdentitySignal"
            }
          },
          "descriptionChars": {
            "type": "integer",
            "minimum": 0,
            "description": "Visible meta description length, in characters."
          },
          "canonical": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Absolute canonical URL declared by the page, when one exists."
          },
          "error": {
            "type": "string"
          },
          "fetchMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "FreshnessSignal": {
        "type": "object",
        "required": [
          "source",
          "property",
          "iso",
          "line"
        ],
        "description": "A machine-readable date found on a page or in its sitemap entry.",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "json-ld",
              "meta",
              "time",
              "sitemap",
              "header"
            ]
          },
          "property": {
            "type": "string",
            "example": "dateModified"
          },
          "iso": {
            "type": "string",
            "format": "date-time"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "AgentFetchComparison": {
        "type": "object",
        "required": [
          "userAgent",
          "status",
          "blocked",
          "challenge",
          "bytes",
          "finalUrl",
          "detail"
        ],
        "description": "One AI user-agent fetch compared with the default fetch.",
        "properties": {
          "userAgent": {
            "type": "string",
            "example": "GPTBot"
          },
          "status": {
            "type": "integer"
          },
          "blocked": {
            "type": "boolean",
            "description": "True when the AI user agent received a different status or a body under 20% of the default size."
          },
          "challenge": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "cloudflare",
              "akamai",
              "generic",
              null
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "finalUrl": {
            "type": "string",
            "format": "uri"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "IdentitySignal": {
        "type": "object",
        "required": [
          "type",
          "format",
          "name",
          "url",
          "description",
          "sameAs",
          "jobTitle",
          "knowsAbout",
          "line"
        ],
        "description": "Summary of a Person or Organization node found in a page's structured data.",
        "properties": {
          "type": {
            "type": "string",
            "example": "Organization"
          },
          "format": {
            "$ref": "#/components/schemas/StructuredDataFormat"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "sameAs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "jobTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "knowsAbout": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "StructuredDataFormat": {
        "type": "string",
        "enum": [
          "json-ld",
          "microdata",
          "rdfa"
        ]
      },
      "AuditCoverage": {
        "type": "object",
        "required": [
          "method",
          "inventorySize",
          "listedPages",
          "sampleSize",
          "analyzedPages",
          "failedPages",
          "skippedPages",
          "sitemapFound",
          "homepageFallback",
          "truncated",
          "deadlineHit",
          "note"
        ],
        "description": "How the inventory and sample were built, including failures and deadline truncation.",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "sitemap",
              "links",
              "homepage",
              "page"
            ]
          },
          "inventorySize": {
            "type": "integer",
            "minimum": 0,
            "description": "Unique page-like URLs before the display cap."
          },
          "listedPages": {
            "type": "integer",
            "minimum": 0,
            "description": "URLs included in pages for the llms.txt editor."
          },
          "sampleSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Pages selected for the sample, including the seed."
          },
          "analyzedPages": {
            "type": "integer",
            "minimum": 0,
            "description": "Pages that produced page-level checks."
          },
          "failedPages": {
            "type": "integer",
            "minimum": 0,
            "description": "Selected pages that could not be analyzed."
          },
          "skippedPages": {
            "type": "integer",
            "minimum": 0,
            "description": "Inventory pages not selected because of the cap or deadline."
          },
          "sitemapFound": {
            "type": "boolean"
          },
          "homepageFallback": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "deadlineHit": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
