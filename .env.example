# Optional: absolute site URL used for canonical metadata, sitemap and robots.txt.
# Defaults to the Vercel deployment URL when deployed, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: repository link used in the header, footer and README badge.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ABradwell/llm-seo-toolbox

# Optional: Buy Me a Coffee profile URL shown in the footer banner.
NEXT_PUBLIC_BMC_URL=https://buymeacoffee.com/bradwell
